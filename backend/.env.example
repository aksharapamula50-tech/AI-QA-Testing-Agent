# Optional. Leave AI_API_KEY unset to use transparent local heuristic reviews.
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini
# Optional: defaults to backend/qa_agent.db
# QA_DB_PATH=./qa_agent.db
# Optional: comma-separated exact browser origins
# CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://192.168.1.3:5173
# Optional: set a random value (at least 32 characters) instead of the locally generated backend/.auth_secret
# QA_AUTH_SECRET=
# Set to 1 when serving over HTTPS so the session cookie uses the Secure flag
# QA_COOKIE_SECURE=0
